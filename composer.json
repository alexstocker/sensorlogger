{
    "name": "alexstocker/sensorlogger",
    "description": "SensorLogger for owncloud",
    "type": "project",
    "version": "0.1.1",
    "license": "AGPL",
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/alexstocker/sensorlogger.git"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpcompatibility/php-compatibility": "^10.0@dev",
        "squizlabs/php_codesniffer": "4.x-dev"
    },
    "autoload": {},
    "autoload-dev": {},
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
